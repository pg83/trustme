            for (uint8_t j = 0; j < paired_len; j += 2) {
                int32_t low = mrustc_x86_pcmp_element(input1, j, control);
                int32_t high = mrustc_x86_pcmp_element(input1, j + 1, control);
                if (low <= value && value <= high) state.mask |= 1u << i;
